{
  "name": "porthole-desktop",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Porthole \u2014 a CachyOS-flavoured browser desktop environment for the Porthole x86-64 runtime.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check:no-any && npm run check:boundaries && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check:no-any": "node scripts/check-no-any.mjs",
    "check:boundaries": "node scripts/check-ui-boundaries.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
