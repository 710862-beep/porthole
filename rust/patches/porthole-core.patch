+#[cfg(test)]
+mod porthole_thread_tests {
+    use super::*;
+    #[test]
+    fn completed_cpu_is_not_scheduled() {
+        let mut x86 = X86::new();
+        x86.cpu_mut().state = CPUState::Terminated(7);
+        x86.new_cpu();
+        x86.schedule();
+        assert_eq!(x86.cur_cpu, 1);
+    }
+    #[test]
+    fn all_completed_does_not_unwrap_an_empty_deadline() {
+        let mut x86 = X86::new();
+        x86.cpu_mut().state = CPUState::Terminated(0);
+        x86.schedule();
+        assert_eq!(x86.cpu().state, CPUState::Terminated(0));
+    }
+}
