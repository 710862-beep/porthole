+#[win32_derive::dllexport]
+pub async fn send(machine:&mut Machine,s:u32,buf:u32,len:i32,flags:u32)->u32 {
+    if !machine.state.ws2_32.sockets.contains(&s) {return fail(machine,10038);}
+    if flags!=0 {return fail(machine,10045);}
